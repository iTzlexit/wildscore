<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon, Android 8 and up. The launcher supplies the mask, so the
    foreground is drawn small and centred inside a large transparent canvas —
    anything outside the middle 66/108 can be cropped by a round, squircle or
    teardrop shape depending on the phone.

    Regenerate both layers with: dart run tool/generate_icon.dart
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
